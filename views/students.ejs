<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
<h1><%= title %></h1>
<ul>
    <% students.forEach(student => { %>
        <li>
            <a href="/students/<%= student.id %>">
                <%= student.name %>
            </a>
        </li>
    <% }) %>
</ul>
<p><a href="/">На головну</a></p>
</body>
</html>
